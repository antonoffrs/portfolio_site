<!DOCTYPE html>
<html lang="ru" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Роман Антонов | Руководитель IT-проектов и программ (PME, PRIME)</title>
    <meta name="description" content="Портфолио руководителя IT-проектов и программ (PME, PRIME). Облачная миграция, ЦОД, ИТ-инфраструктура, бюджеты > 1 млрд руб.">
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Phosphor Icons -->
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#eff6ff',
                            100: '#dbeafe',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8',
                            800: '#1e40af',
                            900: '#1e3a8a',
                            950: '#172554',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
        .reveal {
            opacity: 0;
            transform: translateY(20px);
            transition: all 0.6s ease-out;
        }
        .reveal.active {
            opacity: 1;
            transform: translateY(0);
        }
        .glass-nav {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased selection:bg-brand-500 selection:text-white">

    <!-- Навигация -->
    <nav class="fixed w-full z-50 top-0 glass-nav border-b border-slate-200 transition-all duration-300">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <div class="flex-shrink-0 font-bold text-xl text-brand-900 tracking-tight flex items-center gap-2">
                    <a href="#home">Роман Антонов<span class="text-brand-500">.</span>PM</a>
                    <span class="hidden sm:inline-block text-xs font-semibold px-2 py-0.5 bg-brand-100 text-brand-800 rounded-md">PME • PRIME</span>
                </div>
                <!-- Десктопное меню -->
                <div class="hidden md:block">
                    <div class="ml-10 flex items-baseline space-x-6">
                        <a href="#home" class="hover:text-brand-600 text-slate-600 px-3 py-2 rounded-md text-sm font-medium transition-colors">Главная</a>
                        <a href="#experience" class="hover:text-brand-600 text-slate-600 px-3 py-2 rounded-md text-sm font-medium transition-colors">Опыт работы</a>
                        <a href="#skills" class="hover:text-brand-600 text-slate-600 px-3 py-2 rounded-md text-sm font-medium transition-colors">Компетенции</a>
                        <a href="#education" class="hover:text-brand-600 text-slate-600 px-3 py-2 rounded-md text-sm font-medium transition-colors">Сертификации</a>
                        <a href="#contact" class="bg-brand-600 hover:bg-brand-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors shadow-sm">Связаться</a>
                    </div>
                </div>
                <!-- Кнопка мобильного меню -->
                <div class="md:hidden">
                    <button id="mobile-menu-btn" class="text-slate-600 hover:text-brand-600 p-2 focus:outline-none">
                        <i class="ph ph-list text-2xl"></i>
                    </button>
                </div>
            </div>
        </div>
